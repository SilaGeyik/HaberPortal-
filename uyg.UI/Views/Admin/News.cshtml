@{
	Layout = "_AdminLayout";
}
<div class="d-flex justify-content-between align-items-center mb-4">
	<h2 class="fw-bold m-0"><i class="fas fa-newspaper text-primary me-2"></i>Haber Yönetimi</h2>
	<button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openModal(false)">
		<i class="fas fa-plus me-2"></i>Yeni Haber Ekle
	</button>
</div>
<div class="table-responsive">
	<table class="table table-hover align-middle border-top">
		<thead class="bg-light small fw-bold text-muted text-uppercase">
			<tr>
				<th class="ps-3 py-3">Görsel</th>
				<th>Haber Başlığı</th>
				<th>Kategori</th>
				<th class="text-end pe-3">İşlemler</th>
			</tr>
		</thead>
		<tbody id="newsList">
		</tbody>
	</table>
</div>
<div class="modal fade" id="newsModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered">
		<div class="modal-content border-0 shadow-lg rounded-4">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold" id="modalTitle">Haber Düzenle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body p-4">
				<form id="newsForm">
					<input type="hidden" id="mId">
					<div class="row g-3">
						<div class="col-md-8">
							<label class="form-label small fw-bold">Haber Başlığı</label>
							<input type="text" id="mTitle" class="form-control rounded-3" required>
						</div>
						<div class="col-md-4">
							<label class="form-label small fw-bold">Kategori</label>
							<select id="mCategoryId" class="form-select rounded-3"></select>
						</div>
						<div class="col-12">
							<label class="form-label small fw-bold">Görsel URL</label>
							<input type="text" id="mImageUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/...">
						</div>
						<div class="col-12">
							<label class="form-label small fw-bold">Haber İçeriği</label>
<textarea id="mContent" class="form-control rounded-3" rows="8" required></textarea>
						</div>
					</div>
				</form>
			</div>
			<div class="modal-footer border-0 pt-0">
				<button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
				<button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="saveNews()">Değişiklikleri Kaydet</button>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>
		var apiUrl = "https://localhost:7278/api/";
		var newsModal = new bootstrap.Modal(document.getElementById('newsModal'));
		var isEditMode = false;
		function loadNews() {
		$.get(apiUrl + "News", function(data) {
		var h = "";
		data.forEach(n => {
		var imgSrc = n.imageUrl || n.ImageUrl || "https://picsum.photos/200/120";
		h += `
		<tr>
		<td class="ps-4">
		<img src="${imgSrc}" class="rounded-3 shadow-sm" style="width:90px; height:55px; object-fit:cover;" onerror="this.src='https://picsum.photos/200/120'">
		</td>
		<td>
		<div class="fw-bold text-dark">${n.title}</div>
		<div class="text-muted small">ID: #${n.id}</div>
		</td>
		<td><span class="badge bg-soft-primary text-primary rounded-pill px-3">${n.categoryName}</span></td>
		<td class="text-end pe-4">
		<button class="btn btn-light btn-sm rounded-circle me-1" onclick="getNewsForEdit(${n.id})" title="Düzenle">
		<i class="fas fa-edit text-primary"></i>
		</button>
		<button class="btn btn-light btn-sm rounded-circle" onclick="deleteNews(${n.id})" title="Sil">
		<i class="fas fa-trash text-danger"></i>
		</button>
		</td>
		</tr>`;
		});
		$("#newsList").html(h);
		});
		}
		function openModal(editMode) {
		isEditMode = editMode;
		$("#modalTitle").text(editMode ? "Haberi Güncelle" : "Yeni Haber Ekle");
		if (!editMode) {
		$("#newsForm")[0].reset();
		$("#mId").val("");
		}
		// Kategorileri Yükle
		$.get(apiUrl + "Categories", function(data) {
		var opt = "";
		data.forEach(c => { opt += `<option value="${c.id}">${c.name}</option>`; });
		$("#mCategoryId").html(opt);
		newsModal.show();
		});
		}
		// DÜZENLEME İÇİN VERİ GETİR
		function getNewsForEdit(id) {
		$.get(apiUrl + "News/" + id, function(n) {
		$("#mId").val(n.id);
		$("#mTitle").val(n.title);
		$("#mImageUrl").val(n.imageUrl || n.ImageUrl);
		$("#mContent").val(n.content);
		openModal(true);
		$("#mCategoryId").val(n.categoryId);
		});
		}
		function saveNews() {
		var token = localStorage.getItem("token");
		var id = $("#mId").val();
		var data = {
		id: id ? parseInt(id) : 0,
		title: $("#mTitle").val(),
		categoryId: parseInt($("#mCategoryId").val()),
		imageUrl: $("#mImageUrl").val(),
		content: $("#mContent").val(),
		summary: $("#mTitle").val().substring(0, 50)
		};
		var type = isEditMode ? "PUT" : "POST";
		var url = apiUrl + "News" + (isEditMode ? "/" + id : "");
		$.ajax({
		url: url,
		type: type,
		headers: { "Authorization": "Bearer " + token },
		contentType: "application/json",
		data: JSON.stringify(data),
		success: function() {
		newsModal.hide();
		loadNews();
		alert(isEditMode ? "Haber güncellendi!" : "Haber eklendi!");
		}
		});
		}
		function deleteNews(id) {
		if (confirm("Bu haberi silmek istediğinize emin misiniz?")) {
		var token = localStorage.getItem("token");
		$.ajax({
		url: apiUrl + "News/" + id,
		type: "DELETE",
		headers: { "Authorization": "Bearer " + token },
		success: function() { loadNews(); }
		});
		}
		}
		$(document).ready(loadNews);
	</script>
}
<style>
	.bg-soft-primary {
		background-color: #e7f1ff;
	}

	.table thead th {
		border-top: none;
	}

	.btn-light {
		background-color: #f8f9fa;
		border: none;
	}

		.btn-light:hover {
			background-color: #e9ecef;
		}
</style>