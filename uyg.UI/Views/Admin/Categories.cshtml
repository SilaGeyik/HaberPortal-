@{
	Layout = "_AdminLayout";
}
<div class="container-fluid px-4">
	<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
		<h1 class="fw-bold text-dark">Kategori Yönetimi</h1>
	</div>
	<div class="card border-0 shadow-sm rounded-4 mb-4">
		<div class="card-body p-4">
			<h6 class="fw-bold mb-3">Yeni Kategori Ekle</h6>
			<div class="input-group">
				<input type="text" id="newCatName" class="form-control rounded-pill-start border-2" placeholder="Kategori adını yazın...">
				<button class="btn btn-success rounded-pill-end px-4 fw-bold" onclick="addCategory()">
					<i class="fas fa-plus me-2"></i>Ekle
				</button>
			</div>
		</div>
	</div>
	<div class="card border-0 shadow-sm rounded-4">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="bg-light text-muted small text-uppercase">
						<tr>
							<th class="ps-4" style="width: 80px;">ID</th>
							<th>Kategori Adı</th>
							<th class="text-end pe-4">İşlemler</th>
						</tr>
					</thead>
					<tbody id="catList">
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow-lg rounded-4">
			<div class="modal-header border-0">
				<h5 class="modal-title fw-bold">Kategoriyi Düzenle</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body p-4">
				<input type="hidden" id="editId">
				<div class="mb-3">
					<label class="form-label small fw-bold">Yeni Kategori Adı</label>
					<input type="text" id="editName" class="form-control rounded-3 border-2">
				</div>
			</div>
			<div class="modal-footer border-0 pt-0">
				<button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
				<button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" onclick="updateCategory()">Güncelle</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		var apiUrl = "https://localhost:7278/api/Categories";
		var editModal;

		function loadCategories() {
			$.get(apiUrl, function(data) {
				var h = "";
				data.forEach(c => {
					h += `
					<tr>
						<td class="ps-4 text-muted">#${c.id}</td>
						<td><span class="fw-bold text-dark">${c.name}</span></td>
						<td class="text-end pe-4">
							<button class="btn btn-light btn-sm rounded-circle me-1" onclick="openEditModal(${c.id}, '${c.name.replace(/'/g, "\\'")}')" title="Düzenle">
								<i class="fas fa-pen text-primary"></i>
							</button>
							<button class="btn btn-light btn-sm rounded-circle" onclick="deleteCategory(${c.id})" title="Sil">
								<i class="fas fa-trash text-danger"></i>
							</button>
						</td>
					</tr>`;
				});
				$("#catList").html(h);
			});
		}

		function addCategory() {
			var name = $("#newCatName").val().trim();
			if(!name) { alert("Lütfen bir isim yazın!"); return; }
			var token = localStorage.getItem("token");
			$.ajax({
				url: apiUrl,
				type: "POST",
				headers: { "Authorization": "Bearer " + token },
				contentType: "application/json",
				data: JSON.stringify({ name: name }),
				success: function() {
					$("#newCatName").val("");
					loadCategories();
					alert("Kategori eklendi!");
				},
				error: function() {
					alert("Kategori eklenirken bir hata oluştu.");
				}
			});
		}

		function openEditModal(id, name) {
			$("#editId").val(id);
			$("#editName").val(name);
			editModal.show();
		}

		function updateCategory() {
			var id = $("#editId").val();
			var name = $("#editName").val().trim();
			var token = localStorage.getItem("token");
			if(!name) { alert("Lütfen bir isim yazın!"); return; }

			$.ajax({
				url: apiUrl + "/" + id,
				type: "PUT",
				headers: { "Authorization": "Bearer " + token },
				contentType: "application/json",
				data: JSON.stringify({ id: parseInt(id), name: name }),
				success: function() {
					editModal.hide();
					loadCategories();
					alert("Kategori güncellendi!");
				},
				error: function() {
					alert("Güncelleme işlemi başarısız oldu.");
				}
			});
		}

		function deleteCategory(id) {
			if(confirm("Bu kategoriyi silmek istediğinize emin misiniz? (Bu kategoriye bağlı haberler varsa silinmeyebilir)")) {
				var token = localStorage.getItem("token");
				$.ajax({
					url: apiUrl + "/" + id,
					type: "DELETE",
					headers: { "Authorization": "Bearer " + token },
					success: function() {
						loadCategories();
					},
					error: function() {
						alert("Silme işlemi başarısız oldu. Kategoriye bağlı haberler olabilir.");
					}
				});
			}
		}

		// Tüm sayfa yüklendikten sonra modal'ı tanımla ve kategorileri getir
		$(document).ready(function() {
			editModal = new bootstrap.Modal(document.getElementById('editModal'));
			loadCategories();
		});
	</script>
}

<style>
	.rounded-pill-start {
		border-radius: 50px 0 0 50px !important;
	}

	.rounded-pill-end {
		border-radius: 0 50px 50px 0 !important;
	}

	.btn-light {
		background-color: #f8f9fa;
		border: none;
	}

		.btn-light:hover {
			background-color: #e9ecef;
		}
</style>