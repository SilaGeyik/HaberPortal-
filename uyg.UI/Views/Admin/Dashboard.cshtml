@{
    Layout = "_AdminLayout";
}
<h2 class="fw-bold text-dark mb-4">Sistem Özeti</h2>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 bg-primary text-white shadow-sm rounded-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div><p class="small mb-0 opacity-75">Toplam Haber</p><h2 class="fw-bold mb-0" id="statNews">0</h2></div>
                <i class="fas fa-newspaper fa-2x opacity-25"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-success text-white shadow-sm rounded-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div><p class="small mb-0 opacity-75">Kategori Sayısı</p><h2 class="fw-bold mb-0" id="statCats">0</h2></div>
                <i class="fas fa-tags fa-2x opacity-25"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-warning text-white shadow-sm rounded-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div><p class="small mb-0 opacity-75">Yorumlar</p><h2 class="fw-bold mb-0" id="statComments">0</h2></div>
                <i class="fas fa-comments fa-2x opacity-25"></i>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var apiUrl = "https://localhost:7278/api/";
            var token = localStorage.getItem("token");

            // Haber sayısını çek
            $.get(apiUrl + "News", data => $("#statNews").text(data.length));

            // Kategori sayısını çek
            $.get(apiUrl + "Categories", data => $("#statCats").text(data.length));

            // Yorum sayısını çek
            $.ajax({
                url: apiUrl + "Comments",
                type: "GET",
                headers: { "Authorization": "Bearer " + token },
                success: data => $("#statComments").text(data.length)
            });
        });
    </script>
}