@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<title>Giriş Yap | GYKHABER</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
	<style>
		body {
			background-color: #f4f7f6;
			font-family: 'Segoe UI', sans-serif;
		}

		.login-card {
			margin-top: 100px;
			border: none;
			border-radius: 15px;
			box-shadow: 0 10px 30px rgba(0,0,0,0.1);
		}
	</style>
</head>
<body>
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-4">
				<div class="card login-card">
					<div class="card-header bg-primary text-white text-center py-3">
						<h4 class="mb-0">GYKHABER GİRİŞ</h4>
					</div>
					<div class="card-body p-4">
						<div class="mb-3">
							<label class="form-label">E-posta</label>
							<input type="email" id="txtEmail" class="form-control" placeholder="E-posta">
						</div>
						<div class="mb-3">
							<label class="form-label">Şifre</label>
							<input type="password" id="txtPassword" class="form-control" placeholder="******">
						</div>
						<button type="button" onclick="doLogin()" class="btn btn-primary w-100 py-2 fw-bold">Giriş Yap</button>
						<div class="text-center mt-3 small">
							<a href="/Auth/Register" class="text-decoration-none">Hesabınız yok mu? Kayıt Olun</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script>
		function doLogin() {
			var data = { email: $("#txtEmail").val(), password: $("#txtPassword").val() };

			$.ajax({
				url: "https://localhost:7278/api/Auth/login",
				type: "POST",
				contentType: "application/json",
				data: JSON.stringify(data),
				success: function (res) {
					localStorage.setItem("token", res.token);
					localStorage.setItem("roles", JSON.stringify(res.roles));

					var savedName = localStorage.getItem("userFullName");
					var finalName = "";

					if (res.firstName && res.lastName) {
						finalName = (res.firstName + " " + res.lastName).toUpperCase();
					} else if (savedName && savedName.length > 2 && !savedName.includes("@@")) {
						finalName = savedName.toUpperCase(); 
					} else {
						finalName = (res.userName || "KULLANICI").split('@@')[0].toUpperCase();
					}

					localStorage.setItem("userFullName", finalName);

					var isAdmin = res.roles && res.roles.some(r => r.toLowerCase() === "admin");
					window.location.href = isAdmin ? "/Admin/Dashboard" : "/Home/Index";
				},
				error: function () {
					alert("Giriş başarısız! Bilgilerinizi kontrol edin.");
				}
			});
		}
	</script>
</body>
</html>