@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<title>Kayıt Ol | GYKHABER</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
	<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-4">
				<div class="card shadow border-0 rounded-4">
					<div class="card-header bg-success text-white text-center py-3"><h4>GYKHABER KAYIT</h4></div>
					<div class="card-body p-4">
						<input type="text" id="rFirstName" class="form-control mb-2" placeholder="Adınız">
						<input type="text" id="rLastName" class="form-control mb-2" placeholder="Soyadınız">
						<input type="email" id="rEmail" class="form-control mb-2" placeholder="E-posta">
						<input type="password" id="rPassword" class="form-control mb-2" placeholder="Şifre">
						<input type="password" id="rConfirmPassword" class="form-control mb-3" placeholder="Şifre Tekrarı">
						<button type="button" onclick="doRegister()" class="btn btn-success w-100 py-2 fw-bold">Kaydı Tamamla</button>
						<div class="text-center mt-3 small"><a href="/Auth/Login">Giriş Yap</a></div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script>
		function doRegister() {
		var p = $("#rPassword").val();
		if(p !== $("#rConfirmPassword").val()){ alert("Şifreler uymuyor!"); return; }
		var data = {
		firstName: $("#rFirstName").val(),
		lastName: $("#rLastName").val(),
		email: $("#rEmail").val(),
		userName: $("#rEmail").val(),
		password: p,
		confirmPassword: p
		};
		$.ajax({
		url: "https://localhost:7278/api/Auth/register",
		type: "POST",
		contentType: "application/json",
		data: JSON.stringify(data),
		success: function () {
		localStorage.setItem("userFullName", $("#rFirstName").val().toUpperCase() + " " + $("#rLastName").val().toUpperCase());
		alert("Kayıt başarılı!");
		window.location.href = "/Auth/Login";
		},
		error: function (x) { alert("Hata: " + JSON.stringify(x.responseJSON)); }
		});
		}
	</script>
</body>
</html>