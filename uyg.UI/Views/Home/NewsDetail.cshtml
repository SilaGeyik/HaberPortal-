@{
    Layout = "_Layout";
}

<div id="readProgress" style="position:fixed; top:0; left:0; width:0; height:5px; background-color:#cc0000; z-index:99999; transition:width 0.1s ease;"></div>

<style>
    .article-container {
        max-width: 820px;
        margin: 0 auto;
    }

    .article-cat {
        color: #cc0000;
        font-weight: 800;
        font-size: 1rem;
        text-transform: uppercase;
        margin-bottom: 10px;
        display: block;
    }

    .article-title {
        font-weight: 900;
        font-size: 2.5rem;
        line-height: 1.15;
        color: #000;
        margin-bottom: 25px;
    }

    .article-meta {
        border-top: 1px solid #000;
        border-bottom: 1px solid #ddd;
        padding: 12px 0;
        margin-bottom: 30px;
        font-size: 0.9rem;
        color: #555;
        font-weight: 500;
    }

    .article-img {
        width: 100%;
        margin-bottom: 30px;
        background-color: #e9ecef;
        border-radius: 4px;
    }

    .article-content {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #222;
    }

    .social-btn {
        display: inline-flex;
        width: 32px;
        height: 32px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #fff;
        text-decoration: none;
        margin-right: 5px;
        font-size: 0.85rem;
    }

        .social-btn:hover {
            color: #fff;
            opacity: 0.8;
        }

    .bg-tw {
        background: #1DA1F2;
    }

    .bg-fb {
        background: #4267B2;
    }

    .bg-wa {
        background: #25D366;
    }
</style>

<div class="article-container mt-4">
    <span id="nCat" class="article-cat"></span>
    <h1 id="nTitle" class="article-title"></h1>

    <div class="article-meta d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div><i class="fas fa-pen-nib text-danger me-2"></i><span id="nAuthor"></span> &nbsp;|&nbsp; <i class="far fa-clock text-danger me-2"></i><span id="nDate"></span></div>
        <div class="d-flex align-items-center position-relative">
            <span class="me-2 fw-bold text-dark">Paylaş:</span>
            <a href="#" id="sTw" target="_blank" class="social-btn bg-tw"><i class="fab fa-twitter"></i></a>
            <a href="#" id="sFb" target="_blank" class="social-btn bg-fb"><i class="fab fa-facebook-f"></i></a>
            <a href="#" id="sWa" target="_blank" class="social-btn bg-wa"><i class="fab fa-whatsapp"></i></a>
            <button id="btnLike" onclick="toggleLike()" class="btn btn-outline-danger btn-sm rounded-0 ms-3 fw-bold px-3 position-relative"><i class="far fa-heart me-1"></i> Beğen</button>
        </div>
    </div>

    <img id="nImg" class="article-img">

    <div id="nContent" class="article-content mb-5" style="white-space: pre-line;"></div>

    <div class="bg-light p-4 border mb-5">
        <h5 class="fw-black mb-4 border-bottom border-dark pb-2">Okuyucu Yorumları</h5>
        <div id="nComments"></div>
        <hr class="my-4">
        <textarea id="tComment" class="form-control rounded-0 mb-3" rows="4" placeholder="Görüşlerinizi bizimle paylaşın..."></textarea>
        <button onclick="postComm()" class="btn btn-dark rounded-0 px-4 fw-bold">YORUMU GÖNDER</button>
    </div>
</div>

@section Scripts {
    <script>
        var newsId = new URLSearchParams(window.location.search).get('id');

        function load() {
            $.get(apiUrl + "News/" + newsId, function(x) {
                $("#nCat").text(x.categoryName);
                $("#nTitle").text(x.title);
                $("#nContent").text(x.content);
                $("#nAuthor").text(x.authorName);
                $("#nDate").text(new Date(x.publishedAt).toLocaleDateString('tr-TR', { day:'2-digit', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }));

                var img = x.imageUrl && x.imageUrl.startsWith("http") ? x.imageUrl : "https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200";
                $("#nImg").attr("src", img).on("error", function() { $(this).attr("src", fallbackImg); });

                var url = encodeURIComponent(window.location.href);
                $("#sTw").attr("href", "https://twitter.com/intent/tweet?url=" + url + "&text=" + encodeURIComponent(x.title));
                $("#sFb").attr("href", "https://www.facebook.com/sharer/sharer.php?u=" + url);
                $("#sWa").attr("href", "https://api.whatsapp.com/send?text=" + url);

                var cHtml = "";
                x.comments.forEach(c => { cHtml += `<div class="mb-3 pb-3 border-bottom"><strong class="text-danger">${c.userName}</strong><p class="m-0 mt-1">${c.content}</p></div>`; });
                $("#nComments").html(cHtml || "<p class='text-muted small'>İlk yorumu siz yapın.</p>");
                checkLike();
            });
            $.post(apiUrl + "News/" + newsId + "/view");
        }

        function checkLike() {
            var t = localStorage.getItem("token"); if(!t) return;
            $.ajax({ url: apiUrl + "Likes/news/" + newsId + "/check", type: "GET", headers: {"Authorization":"Bearer "+t},
                success: function(r) {
                    if(r.hasLiked) {
                        $("#btnLike").removeClass("btn-outline-danger").addClass("btn-danger text-white").html('<i class="fas fa-heart me-1"></i> Beğendiniz');
                    }
                }
            });
        }

        function toggleLike() {
            var t = localStorage.getItem("token"); if(!t) return alert("Beğenmek için giriş yapmalısınız.");
            var isLiked = $("#btnLike").hasClass("btn-danger");

            $.ajax({
                url: apiUrl + "Likes/news/" + newsId,
                type: isLiked ? "DELETE" : "POST",
                headers: {"Authorization":"Bearer "+t},
                success: function() {
                    if(!isLiked) { createHearts(); }

                    if(isLiked) {
                        $("#btnLike").removeClass("btn-danger text-white").addClass("btn-outline-danger").html('<i class="far fa-heart me-1"></i> Beğen');
                    } else {
                        $("#btnLike").removeClass("btn-outline-danger").addClass("btn-danger text-white").html('<i class="fas fa-heart me-1"></i> Beğendiniz');
                    }
                }
            });
        }

        function createHearts() {
            const btn = document.getElementById('btnLike');
            const rect = btn.getBoundingClientRect();

            for(let i=0; i<15; i++) {
                const heart = document.createElement('i');
                heart.classList.add('fas', 'fa-heart', 'heart-particle');

                const dx = (Math.random() - 0.5) * 200 + 'px';
                const dy = (Math.random() - 0.7) * 200 + 'px';
                heart.style.setProperty('--dx', dx);
                heart.style.setProperty('--dy', dy);

                heart.style.left = (rect.left + rect.width / 2) + window.scrollX + 'px';
                heart.style.top = (rect.top + rect.height / 2) + window.scrollY + 'px';

                document.body.appendChild(heart);
                setTimeout(() => heart.remove(), 1000);
            }
        }

        function postComm() {
            var t = localStorage.getItem("token"); var b = $("#tComment").val().trim();
            if(!t || !b) return alert("Boş yorum gönderemezsiniz!");
            $.ajax({ url: apiUrl + "Comments", type: "POST", headers: {"Authorization":"Bearer "+t}, contentType: "application/json", data: JSON.stringify({ newsId: parseInt(newsId), content: b }), success: function() { $("#tComment").val(""); load(); }});
        }

        window.onscroll = function() {
            var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            var scrolled = (winScroll / height) * 100;
            document.getElementById("readProgress").style.width = scrolled + "%";
        };

        $(document).ready(load);
    </script>
}