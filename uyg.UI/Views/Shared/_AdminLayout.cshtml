<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Yönetim | GYKHABER</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background: #f8f9fa;
            margin: 0;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            background: #111;
            position: fixed;
            color: #fff;
        }

        .main-content {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }

        .nav-link {
            color: #aaa !important;
            padding: 14px 20px;
            display: block;
            text-decoration: none;
            border-left: 4px solid transparent;
            font-weight: 500;
        }

            .nav-link:hover, .active {
                background: #222;
                color: #fff !important;
                border-left-color: #cc0000;
            }
    </style>
</head>
<body>
    <div class="sidebar shadow">
        <div class="p-4 fw-bold fs-4 text-white text-center border-bottom border-dark">GYK<span class="text-danger">PANEL</span></div>
        <div class="mt-3">
            <a href="/Admin/Dashboard" class="nav-link admin-only"><i class="fas fa-chart-line me-2"></i>Özet</a>
            <a href="/Admin/News" class="nav-link"><i class="fas fa-newspaper me-2"></i>Haber Yönetimi</a>
            <a href="/Admin/Categories" class="nav-link admin-only"><i class="fas fa-tags me-2"></i>Kategoriler</a>
            <a href="/Admin/Comments" class="nav-link admin-only"><i class="fas fa-comments me-2"></i>Yorumlar</a>
            <hr class="mx-3 border-secondary">
            <a href="/Home/Index" class="nav-link text-info"><i class="fas fa-globe me-2"></i>Siteye Dön</a>
        </div>
    </div>

    <div class="main-content">@RenderBody()</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            var roles = JSON.parse(localStorage.getItem("roles") || "[]").map(r => r.toLowerCase());
            if (!roles.includes("admin")) {
                $(".admin-only").hide();
                if(!window.location.pathname.toLowerCase().includes("news")) window.location.href="/Admin/News";
            }
            $(".nav-link").each(function() { if(this.href === window.location.href) $(this).addClass("active"); });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>